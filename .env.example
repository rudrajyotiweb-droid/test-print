# ---------- Server ----------
# Port the Express API listens on
PORT=4000
# Public URL of the customer web app (QR codes point to PUBLIC_URL/s/<shopId>)
PUBLIC_URL=http://localhost:5173
# Public URL of the API, used to build file_url for the print agent.
# Leave empty to derive it from the incoming request host.
API_URL=http://localhost:4000
# Secret used to sign admin JWT cookies. CHANGE THIS in production.
JWT_SECRET=change-me
# Password for the platform owner panel (/superadmin). Empty = panel disabled.
SUPERADMIN_PASSWORD=
# Timezone used for "today" stats and daily pickup codes
TZ=Asia/Kolkata

# ---------- Payments (Razorpay) ----------
PAYMENT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Uploads ----------
MAX_FILE_MB=25
# Files are deleted this many minutes after a job is printed / failed / cancelled
FILE_RETENTION_MINUTES=60

# ---------- Optional ----------
# DB_PATH=./data/print.db
# UPLOAD_DIR=./uploads
# Cookie SameSite for admin login: lax (same domain) or none (frontend on another domain, needs HTTPS)
# COOKIE_SAMESITE=lax

